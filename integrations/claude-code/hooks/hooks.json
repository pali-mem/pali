{
  "description": "Inject the Pali memory protocol at session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/memory-protocol.txt"]
          }
        ]
      }
    ]
  }
}
